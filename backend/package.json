{
  "name": "kairos-backend",
  "version": "1.0.0",
  "description": "Kairos - API du copilote de support contextuel (Fastify 5 + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node scripts/ensure-test-db.mjs && node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@vercel/functions": "^3.11.3",
    "argon2": "^0.43.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  }
}
