# Copy to .env, then fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32 (64 hexadecimal characters)
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:8080
SEED_DEMO=false        # true = demo data set
DEMO_LOGIN=false       # true = "try the demo" button (AGENT session, never admin). Reserve it for a showcase deployment.

# E-mail (confirmation codes). Empty = in development the message is printed in the console.
SMTP_URL=              # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=Kairos <no-reply@example.com>

# Google / GitHub sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Forge app
FORGE_APP_ID=

# Kairos Brain AI service (optional). Same secret on both sides.
ML_URL=                # e.g. http://ml:8100
ML_API_KEY=
