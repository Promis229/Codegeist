# Copier en .env puis renseigner. Ne jamais committer .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32 (64 caracteres hexadecimaux)
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:8080
SEED_DEMO=false        # true = jeu de donnees de demonstration
DEMO_LOGIN=false       # true = bouton « essayer la demo » (session d'AGENT, jamais admin). A reserver a un deploiement de presentation.

# E-mail (codes de confirmation). Vide = en developpement le message s'affiche dans la console.
SMTP_URL=              # ex. smtps://user:pass@smtp.example.com:465
MAIL_FROM=Kairos <no-reply@example.com>

# Connexion Google / GitHub (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application Forge
FORGE_APP_ID=

# Service d'IA Kairos Brain (facultatif). Meme secret des deux cotes.
ML_URL=                # ex. http://ml:8100
ML_API_KEY=
